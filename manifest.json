{
  "manifest_version": 3,
  "name": "Minimal Firefox Startpage",
  "version": "1.6.0",
  "description": "Minimal clock, quotes, search, launcher, appearance settings, and rate-limit-conscious rotating Unsplash backgrounds.",
  "browser_specific_settings": {
    "gecko": {
      "id": "minimal-startpage@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms"
        ],
        "optional": [
          "authenticationInfo"
        ]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "chrome_settings_overrides": {
    "homepage": "index.html"
  },
  "host_permissions": [
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*"
  ]
}
